# Server Configuration
PORT=5001
NODE_ENV=development

# Database Configuration (Docker container maps 5433 -> 5432)
DATABASE_URL=postgresql://postgres:synapse_password@localhost:5433/synapse_db

# Authentication (JWT)
JWT_ACCESS_SECRET=synapse_super_secret_access_jwt_key_at_least_32_chars!
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=synapse_super_secret_refresh_jwt_key_at_least_32_chars!
JWT_REFRESH_EXPIRATION_DAYS=7

# Client Origin (CORS allowlist)
CORS_ORIGIN=http://localhost:5173

# Security & Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=10

# Business Rules
CANCELLATION_WINDOW_HOURS=2

# Email (Nodemailer - auto-creates Ethereal test account if credentials empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Synapse Health" <no-reply@synapse.health>

# Supabase Configuration
SUPABASE_URL=https://ahbchjlkjcgrwubhgnym.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_Utla9sf7Yqu4_xxw6NqBoA_Pv8oVdQy
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://ahbchjlkjcgrwubhgnym.supabase.co/auth/v1/.well-known/jwks.json
